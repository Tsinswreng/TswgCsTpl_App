<Project Sdk="Microsoft.NET.Sdk">

	<!-- 業務／共享程序集：跨端契約（DTO、服務接口）、強類型 Id、I18n 與異常鍵都在這裡。
		 服務端與 Ui 都引用本專案；本專案自身不依賴任何數據庫或 UI 框架。

		 *共用基礎依賴不放這裡*：本地基礎庫（CsKeyNode／CsErr／CsI18n／CsU128Id／CsRefl／CsSql）
		 與強類型 Id 的源生成器／模板，一律寫在 ../Directory.Build.props——
		 那是所有專案共用的地基，寫在各 csproj 會漂移。本檔只留「只有這個專案才有」的東西。 -->
	<PropertyGroup>
		<RootNamespace>TswgCsTpl</RootNamespace>
	</PropertyGroup>

	<!-- 語言資源：內嵌進程序集，四端（含 Android／WASM）都用同一份載入邏輯，不必各端複製檔案。
		 I18nDict 從「自己所在程序集」找資源，故只有本專案需要內嵌。 -->
	<ItemGroup>
		<EmbeddedResource Include="Infra/I18n/Languages/*.json" />
	</ItemGroup>

</Project>
